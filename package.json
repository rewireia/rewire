{
  "name": "rewire",
  "version": "0.1.0",
  "private": true,
  "description": "Rewire: know which parts of your job AI can do, and learn what comes next.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "npm run dev -w @rewire/api",
    "dev:web": "npm run dev -w @rewire/web",
    "build": "tsc -b && npm run build -w @rewire/web",
    "start": "npm start -w @rewire/api",
    "data:build": "tsx --conditions=rewire-source packages/data/pipeline/build.ts",
    "data:check": "tsx --conditions=rewire-source packages/data/pipeline/build.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -b && tsc -p packages/data/pipeline && tsc -p packages/data/tests && tsc -p packages/engine/tests && tsc -p packages/content/tests && tsc -p packages/contracts/tests && tsc -p apps/api/tests && tsc -p apps/web && tsc -p tools && tsc -p tests/e2e",
    "test": "vitest run",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:live": "playwright test --config tests/e2e/live/playwright.config.ts",
    "check:unused": "knip",
    "check:licences": "tsx --conditions=rewire-source tools/licences.ts --check",
    "check:sources": "tsx --conditions=rewire-source tools/data-sources.ts --check",
    "check:delivery": "tsx --conditions=rewire-source tools/check-delivery.ts",
    "notices": "tsx --conditions=rewire-source tools/licences.ts --write",
    "docs:sources": "tsx --conditions=rewire-source tools/data-sources.ts --write",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run data:check && npm run check:unused && npm run check:licences && npm run check:sources && npm run check:delivery"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.6",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "hono": "4.13.17",
    "knip": "6.45.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
