# Copy to .env and fill in what you have. Every credential is optional: without PayPal the
# site shows its catalogue but sells nothing, and without an AI key it works without the guide.
# Never commit .env.

# Runtime: development, test or production
APP_ENV=
HOST=
PORT=
LOG_LEVEL=

# Database: a local SQLite file by default (file:var/rewire.db, under apps/api)
DATABASE_URL=

# Where the web is served from. Requests that change state are accepted from this origin only.
PUBLIC_ORIGIN=

# The folder of the built web (apps/web/dist after `npm run build`), for the API to serve it
# too: one origin for everything. A relative path starts at apps/api. Leave empty in
# development, where Vite serves the web.
WEB_ROOT=

# Signs the session cookie. Required in production (32 characters or more); elsewhere a
# secret is created on first start and kept in apps/api/var.
SESSION_SECRET=

# PayPal: sandbox (default) or live. Live needs APP_ENV=production.
PAYPAL_ENV=

# The merchant every region sells through unless it has its own below: a REST app of a
# PayPal business account. The webhook id is the id of the app's webhook subscription.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# A sandbox personal account to pay with in `npm run e2e:live`. The server does not read them.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Optional fictional sandbox buyer credentials displayed publicly in the demo checkout.
# Both are required together; email must use @personal.example.com. Never use a real account.
# Rejected for PayPal live. These are separate from the private test credentials above.
PAYPAL_SANDBOX_DEMO_BUYER_EMAIL=
PAYPAL_SANDBOX_DEMO_BUYER_PASSWORD=

# Optional merchants based in the United Kingdom and in the euro area. PayPal offers pay
# later, and settles without converting currency, only to a merchant of the buyer's country.
PAYPAL_UK_CLIENT_ID=
PAYPAL_UK_CLIENT_SECRET=
PAYPAL_UK_WEBHOOK_ID=
PAYPAL_EU_CLIENT_ID=
PAYPAL_EU_CLIENT_SECRET=
PAYPAL_EU_WEBHOOK_ID=

# The AI guide: an OpenAI key turns it on. The model (gpt-6.1-terra), its reasoning effort
# (low, medium or high; high by default) and the daily token budget have sensible defaults.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
GUIDE_DAILY_TOKEN_BUDGET=
# The analyst of the explorer has a daily budget of its own (600000 tokens by default).
ANALYST_DAILY_TOKEN_BUDGET=

# Set to true when the account at the provider lets it use what it receives to improve its
# models (OpenAI's data sharing, for one). The guide then says so before a person writes.
GUIDE_PROVIDER_TRAINS_ON_DATA=

# A licence key of AG Grid Ltd for AG Studio, the commercial dashboard of the explorer's
# "Analyse" view. Read by the web at build time (it is part of the page, like every VITE_
# variable). Without it, "Analyse" runs as AG Grid's trial: a notice in the console and, away
# from 127.0.0.1 and localhost, a watermark. Use beyond evaluation needs a key from AG Grid.
VITE_AG_STUDIO_LICENCE_KEY=
